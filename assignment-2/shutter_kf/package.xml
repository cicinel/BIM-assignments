<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>shutter_kf</name>
  <version>0.0.1</version>
  <description>The shutter_kf package</description>

  <maintainer email="marynel.vazquez@yale.edu">Marynel Vazquez</maintainer>
  <license>MIT</license>

  <buildtool_depend>ament_cmake</buildtool_depend>
  <buildtool_depend>ament_cmake_python</buildtool_depend>

  <depend>rclpy</depend>
  <depend>geometry_msgs</depend>
  <depend>std_msgs</depend>
  <depend>visualization_msgs</depend>
  <!-- Target message -->
  <depend>shutter_lookat</depend>

  <!-- follow_target.launch.py: simulation, MoveIt Servo, and the expert from shutter_behavior_cloning -->
  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>
  <exec_depend>shutter_behavior_cloning</exec_depend>
  <exec_depend>shutter_bringup</exec_depend>
  <exec_depend>shutter_mujoco_sim</exec_depend>
  <exec_depend>shutter_servo</exec_depend>
  <exec_depend>rviz2</exec_depend>
  <exec_depend>python3-numpy</exec_depend>

  <test_depend>ament_lint_auto</test_depend>
  <test_depend>ament_lint_common</test_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
